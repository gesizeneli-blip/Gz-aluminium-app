@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');
:root{--navy:#14283f;--navy2:#203b59;--gold:#c9a45e;--bg:#f4f6f9;--ink:#1d2938;--muted:#788596;--line:#e5eaf0;--white:#fff;--green:#25845c}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:14px}.app-shell{min-height:100vh;display:flex}.sidebar{width:245px;background:var(--navy);color:white;padding:25px 16px;display:flex;flex-direction:column;flex-shrink:0}.brand{display:flex;align-items:center;gap:11px;padding:4px 8px 34px}.brand-mark{width:43px;height:43px;border:1px solid var(--gold);color:var(--gold);display:grid;place-items:center;font:800 18px Manrope;border-radius:11px}.brand strong{font:800 12px Manrope;letter-spacing:.8px;display:block}.brand small{color:#aab8c8;letter-spacing:2px;font-size:9px}.nav-label,.eyebrow{font-size:10px;letter-spacing:1.5px;font-weight:700;color:#91a0b1}.nav-label{padding:0 12px 12px}.nav-item{background:none;border:0;color:#c5cfda;padding:13px 12px;border-radius:9px;text-align:left;display:flex;gap:13px;align-items:center;font:500 13px 'DM Sans';cursor:pointer;margin:2px 0}.nav-item span{flex:1}.nav-item:hover,.nav-item.active{background:#29415b;color:white}.nav-item.active{box-shadow:inset 3px 0 var(--gold)}.sidebar-foot{margin-top:auto;color:#aebdcb;font-size:11px;padding:18px 9px 0;border-top:1px solid #34495f}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#55c58c;margin-right:7px}.main{flex:1;min-width:0;padding:0 34px;max-width:1600px;margin:auto;width:100%}.topbar{height:78px;display:flex;align-items:center;border-bottom:1px solid var(--line);gap:14px}.top-title{font:700 17px Manrope;margin-top:3px}.top-actions{margin-left:auto;display:flex;align-items:center;gap:15px}.local-pill{font-size:11px;color:var(--green);background:#e8f5ee;border-radius:20px;padding:7px 10px}.avatar{width:34px;height:34px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font:700 11px Manrope}.menu-btn{display:none;border:0;background:none;font-size:22px}.view{display:none;padding:28px 0 50px}.view.active{display:block}.welcome{background:linear-gradient(115deg,#14283f,#294866);border-radius:16px;padding:30px 32px;color:white;display:flex;justify-content:space-between;align-items:center;gap:20px;min-height:190px}.welcome h1{font:800 27px Manrope;margin:10px 0 7px}.welcome p{color:#c4d0dc;margin:0}.light{color:#d9c18f}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:19px 0}.stat-card,.panel{background:white;border:1px solid var(--line);border-radius:13px}.stat-card{padding:17px 19px}.stat-card span,.stat-card small{display:block;color:var(--muted);font-size:11px}.stat-card strong{display:block;font:800 27px Manrope;margin:7px 0 2px}.content-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:16px 0}.panel{padding:20px;margin-bottom:16px}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:17px}.panel h2{font:700 15px Manrope;margin:0}.panel-head p,.section-head p{font-size:12px;color:var(--muted);margin:5px 0 0}.quick-actions{display:grid;gap:8px}.quick{display:flex;align-items:center;gap:13px;padding:12px;border:1px solid var(--line);border-radius:10px;background:#fff;text-align:left;cursor:pointer}.quick>b{width:36px;height:36px;border-radius:9px;background:#edf2f7;color:var(--navy);display:grid;place-items:center;font-size:18px}.quick span{flex:1}.quick strong,.quick small{display:block}.quick small{font-size:11px;color:var(--muted);margin-top:3px}.quick i{font-style:normal;color:#8492a2}.empty{padding:35px 15px;text-align:center;color:var(--muted);font-size:12px}.empty strong{display:block;color:var(--ink);font-size:14px;margin:9px}.empty p{max-width:430px;margin:8px auto;line-height:1.6}.notice{background:#edf3f8;border:1px solid #dce7f0;border-radius:10px;padding:13px 15px;color:#536477;font-size:12px;line-height:1.6;margin:16px 0}.notice.warning{background:#fff8eb;border-color:#f0dfbb;color:#80622b}.section-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:20px}.section-head h1{font:800 25px Manrope;margin:5px 0}.section-head .eyebrow{color:var(--gold)}.btn{border:0;border-radius:8px;padding:11px 16px;font:600 12px 'DM Sans';cursor:pointer}.btn-primary{background:var(--navy);color:white}.btn-primary:hover{background:var(--navy2)}.btn-light{background:#fff;color:var(--navy)}.btn-secondary{background:#edf1f5;color:var(--navy);margin-top:12px}.text-btn{border:0;background:none;color:#3c658c;font-size:11px;cursor:pointer}.search{border:1px solid var(--line);border-radius:8px;padding:9px 11px;font:12px 'DM Sans';width:min(240px,48%)}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:12px}th{text-align:left;color:#7d8997;font-size:10px;text-transform:uppercase;letter-spacing:.7px;background:#f8fafc}td,th{padding:12px 10px;border-bottom:1px solid var(--line);white-space:nowrap}td strong{font-weight:600}.muted{color:var(--muted);font-size:12px;line-height:1.6}.icon-btn{border:0;background:#f1f3f6;border-radius:7px;width:30px;height:30px;cursor:pointer}.form-panel{margin-top:16px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form-grid label{display:flex;flex-direction:column;gap:6px;font-size:11px;font-weight:600;color:#536174}.form-grid input,.form-grid select,.form-grid textarea{width:100%;border:1px solid #dfe5eb;border-radius:8px;padding:11px 10px;background:#fff;color:var(--ink);font:12px 'DM Sans';outline:none}.form-grid input:focus,.form-grid select:focus,.form-grid textarea:focus{border-color:#829bb4;box-shadow:0 0 0 3px #eaf0f6}.full{grid-column:1/-1}.form-actions{display:flex;justify-content:flex-end}.window-layout{align-items:start}.step-tag{font-size:9px;letter-spacing:1px;color:#9a7a3d;background:#f8f2e7;padding:7px 9px;border-radius:20px}.preview-tabs{display:flex;gap:6px;background:#f2f5f8;padding:4px;border-radius:8px;width:max-content}.preview-tab{border:0;background:transparent;padding:8px 14px;border-radius:6px;font-size:11px;color:#657386;cursor:pointer}.preview-tab.active{background:#fff;color:var(--navy);box-shadow:0 1px 4px #0001}.drawing-area{background:#f8fafc;border:1px dashed #dce3eb;border-radius:10px;margin-top:14px;min-height:280px;display:flex;align-items:center;justify-content:center;flex-direction:column}.drawing-area svg{width:100%;max-height:260px}.drawing-area text{font:10px 'DM Sans';fill:#627286}.frame{fill:#e7edf3;stroke:#203b59;stroke-width:5}.sash{fill:#dcebf1;stroke:#55728e;stroke-width:3}.mullion{stroke:#55728e;stroke-width:4}.dim{stroke:#b18c4d;stroke-width:1.2}.drawing-caption{font-size:10px;color:#8793a1;padding:8px;text-align:center}.calc-preview{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.calc-preview div{background:#f5f7f9;padding:12px;border-radius:8px}.calc-preview span,.calc-preview strong{display:block}.calc-preview span{font-size:10px;color:var(--muted)}.calc-preview strong{font:700 14px Manrope;margin-top:6px}.calc-preview .muted{font:500 10px 'DM Sans'}.preview-3d{transform:perspective(500px) rotateY(-12deg) rotateX(4deg);filter:drop-shadow(12px 12px 4px #0002)}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;background:#14283f;color:white;padding:12px 18px;border-radius:9px;font-size:12px;transition:.2s;pointer-events:none;z-index:10}.toast.show{opacity:1;transform:translate(-50%,0)}footer{border-top:1px solid var(--line);padding:17px 0 25px;color:#7e8a98;font-size:10px;letter-spacing:.7px}footer span{float:right;letter-spacing:0}.mobile-overlay{display:none}
@media(max-width:900px){.sidebar{width:215px}.main{padding:0 20px}.stats{grid-template-columns:repeat(2,1fr)}.content-grid{grid-template-columns:1fr}.window-layout{grid-template-columns:1fr}}
@media(max-width:650px){.sidebar{position:fixed;z-index:20;left:-260px;top:0;bottom:0;width:245px;transition:left .2s}.sidebar.open{left:0}.menu-btn{display:block}.main{padding:0 14px}.topbar{height:66px}.local-pill{display:none}.welcome{padding:22px;align-items:flex-start;flex-direction:column}.welcome h1{font-size:23px}.stats{gap:9px}.stat-card{padding:13px}.stat-card strong{font-size:23px}.section-head{align-items:flex-start;flex-direction:column}.section-head h1{font-size:23px}.panel{padding:15px}.form-grid{grid-template-columns:1fr}.full{grid-column:auto}.search{width:48%}.calc-preview{grid-template-columns:1fr 1fr}footer span{float:none;display:block;margin-top:6px}.mobile-overlay.show{display:block;position:fixed;inset:0;background:#0007;z-index:15}}
