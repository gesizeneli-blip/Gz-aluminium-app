const DB_NAME='gz_aluminium_local', DB_VERSION=1;
let db;
const state={projects:[],windows:[],materials:[],quotes:[],preview:'2d'};
const $=s=>document.querySelector(s);
const $$=s=>[...document.querySelectorAll(s)];
function openDB(){return new Promise((resolve,reject)=>{const req=indexedDB.open(DB_NAME,DB_VERSION);req.onupgradeneeded=()=>{const d=req.result;['projects','windows','materials','quotes'].forEach(n=>{if(!d.objectStoreNames.contains(n))d.createObjectStore(n,{keyPath:'id'});});};req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);});}
function store(name,mode='readonly'){return db.transaction(name,mode).objectStore(name)}
function all(name){return new Promise((resolve,reject)=>{const r=store(name).getAll();r.onsuccess=()=>resolve(r.result||[]);r.onerror=()=>reject(r.error);});}
function put(name,obj){return new Promise((resolve,reject)=>{const r=store(name,'readwrite').put(obj);r.onsuccess=()=>resolve(obj);r.onerror=()=>reject(r.error);});}
function remove(name,id){return new Promise((resolve,reject)=>{const r=store(name,'readwrite').delete(id);r.onsuccess=resolve;r.onerror=()=>reject(r.error);});}
const uid=()=>crypto.randomUUID?crypto.randomUUID():String(Date.now())+Math.random();
const money=n=>new Intl.NumberFormat('sq-AL',{maximumFractionDigits:2}).format(Number(n)||0)+' lek';
function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400);}
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
async function refresh(){for(const n of Object.keys(state))if(Array.isArray(state[n]))state[n]=await all(n);renderAll();}
function go(view){$$('.view').forEach(v=>v.classList.toggle('active',v.id==='view-'+view));$$('.nav-item').forEach(b=>b.classList.toggle('active',b.dataset.view===view));const names={dashboard:'Paneli kryesor',projects:'Projektet',windows:'Dritaret',materials:'Materialet',quotes:'Ofertat',backup:'Backup & cilësimet'};$('#pageTitle').textContent=names[view]||view;$('#sidebar').classList.remove('open');$('.mobile-overlay')?.classList.remove('show');window.scrollTo(0,0);}
function renderAll(){renderStats();renderProjects();renderWindowProjects();renderWindows();renderMaterials();renderRecent();}
function renderStats(){$('#statProjects').textContent=state.projects.length;$('#statWindows').textContent=state.windows.length;$('#statMaterials').textContent=state.materials.length;$('#statQuotes').textContent=state.quotes.length;}
function renderRecent(){const box=$('#recentProjects');const items=[...state.projects].reverse().slice(0,4);box.innerHTML=items.length?`<table><tbody>${items.map(p=>`<tr><td><strong>${esc(p.name)}</strong><br><small>${esc(p.client)}</small></td><td>${new Date(p.created).toLocaleDateString('sq-AL')}</td></tr>`).join('')}</tbody></table>`:'Ende nuk ka projekte. Krijo projektin e parë.';}
function renderProjects(){const q=($('#projectSearch')?.value||'').toLowerCase();const rows=state.projects.filter(p=>(p.name+' '+p.client+' '+p.phone).toLowerCase().includes(q));$('#projectsList').innerHTML=rows.length?`<table><thead><tr><th>Projekti</th><th>Klienti</th><th>Telefoni</th><th>Data</th><th></th></tr></thead><tbody>${rows.map(p=>`<tr><td><strong>${esc(p.name)}</strong></td><td>${esc(p.client)}</td><td>${esc(p.phone||'—')}</td><td>${new Date(p.created).toLocaleDateString('sq-AL')}</td><td><button class="text-btn" data-delete-project="${p.id}">Fshi</button></td></tr>`).join('')}</tbody></table>`:'<div class="empty">Nuk u gjet asnjë projekt.</div>';}
function renderWindowProjects(){const sel=$('#windowProject');const old=sel.value;sel.innerHTML='<option value="">Zgjidh projektin</option>'+state.projects.map(p=>`<option value="${p.id}">${esc(p.name)} – ${esc(p.client)}</option>`).join('');if(state.projects.some(p=>p.id===old))sel.value=old;}
function renderWindows(){const rows=[...state.windows].reverse();$('#windowsList').innerHTML=rows.length?`<table><thead><tr><th>Elementi</th><th>Projekti</th><th>Sistemi</th><th>Përmasat</th><th>Sipërfaqja</th><th></th></tr></thead><tbody>${rows.map(w=>{const p=state.projects.find(x=>x.id===w.projectId);return `<tr><td><strong>${esc(w.label)}</strong><br><small>${esc(w.configuration)} · ${esc(w.opening)}</small></td><td>${esc(p?.name||'—')}</td><td>${esc(w.system)}</td><td>${w.width} × ${w.height} mm</td><td>${(w.width*w.height/1e6).toFixed(3)} m²</td><td><button class="text-btn" data-delete-window="${w.id}">Fshi</button></td></tr>`}).join('')}</tbody></table>`:'<div class="empty">Nuk ka dritare të regjistruara.</div>';}
function renderMaterials(){const q=($('#materialSearch')?.value||'').toLowerCase();const rows=state.materials.filter(m=>(m.name+' '+m.category+' '+m.code).toLowerCase().includes(q));$('#materialsList').innerHTML=rows.length?`<table><thead><tr><th>Materiali</th><th>Kategoria</th><th>Kodi / Sistemi</th><th>Kosto</th><th>Shitje</th><th>Njësia</th><th></th></tr></thead><tbody>${rows.map(m=>`<tr><td><strong>${esc(m.name)}</strong></td><td>${esc(m.category)}</td><td>${esc(m.code||'—')}</td><td>${money(m.cost)}</td><td>${money(m.sale)}</td><td>${esc(m.unit)}</td><td><button class="text-btn" data-edit-material="${m.id}">Ndrysho</button> <button class="text-btn" data-delete-material="${m.id}">Fshi</button></td></tr>`).join('')}</tbody></table>`:'<div class="empty">Katalogu është bosh. Shto materialin e parë.</div>';}
function updatePreview(){const w=Number($('#windowForm [name=width]').value)||1500,h=Number($('#windowForm [name=height]').value)||1400;$('#areaPreview').textContent=(w*h/1e6).toFixed(3)+' m²';const svg=$('#drawing svg');if(svg){svg.querySelectorAll('text')[0].textContent=w+' mm';svg.querySelectorAll('text')[1].textContent=h+' mm';}const cfg=$('#windowForm [name=configuration]').value;const isTwo=cfg.includes('Dy')||cfg.includes('dy');const isFixed=cfg==='Fikse';const mullion=svg?.querySelector('.mullion');if(mullion)mullion.style.display=isTwo||cfg.includes('+')?'block':'none';if(svg)svg.querySelector('.sash').style.fill=isFixed?'#e7edf3':'#dcebf1';}
function formData(form){return Object.fromEntries(new FormData(form).entries());}
function openMaterialForm(m){const f=$('#materialForm');f.reset();f.elements.id.value=m?.id||'';if(m)Object.entries(m).forEach(([k,v])=>{if(f.elements[k])f.elements[k].value=v??'';});$('#materialFormTitle').textContent=m?'Ndrysho material':'Shto material';$('#materialFormPanel').hidden=false;$('#materialFormPanel').scrollIntoView({behavior:'smooth',block:'start'});}
async function init(){db=await openDB();await refresh();
$$('.nav-item').forEach(b=>b.addEventListener('click',()=>go(b.dataset.view)));
$$('[data-go]').forEach(b=>b.addEventListener('click',()=>go(b.dataset.go)));
$('#menuBtn').addEventListener('click',()=>$('#sidebar').classList.toggle('open'));
$('#newProjectBtn').addEventListener('click',()=>$('#projectFormPanel').hidden=false);
$('#closeProjectForm').addEventListener('click',()=>$('#projectFormPanel').hidden=true);
$('#projectForm').addEventListener('submit',async e=>{e.preventDefault();const d=formData(e.target);await put('projects',{...d,id:uid(),created:new Date().toISOString()});e.target.reset();$('#projectFormPanel').hidden=true;await refresh();toast('Projekti u ruajt.');});
$('#windowForm').addEventListener('submit',async e=>{e.preventDefault();const d=formData(e.target);d.width=Number(d.width);d.height=Number(d.height);d.id=uid();d.created=new Date().toISOString();d.area=d.width*d.height/1e6;await put('windows',d);e.target.reset();updatePreview();await refresh();toast('Dritarja u regjistrua.');});
['width','height','configuration'].forEach(n=>$('#windowForm [name='+n+']').addEventListener('input',updatePreview));
$('#newMaterialBtn').addEventListener('click',()=>openMaterialForm());
$('#closeMaterialForm').addEventListener('click',()=>$('#materialFormPanel').hidden=true);
$('#materialForm').addEventListener('submit',async e=>{e.preventDefault();const d=formData(e.target);d.id=d.id||uid();['cost','sale','length','kerf'].forEach(k=>d[k]=Number(d[k]||0));d.updated=new Date().toISOString();await put('materials',d);e.target.reset();$('#materialFormPanel').hidden=true;await refresh();toast('Materiali u ruajt.');});
$('#projectSearch').addEventListener('input',renderProjects);$('#materialSearch').addEventListener('input',renderMaterials);
document.addEventListener('click',async e=>{const p=e.target.dataset.deleteProject,w=e.target.dataset.deleteWindow,m=e.target.dataset.deleteMaterial,edit=e.target.dataset.editMaterial;if(p&&confirm('Të fshihet projekti? Dritaret e lidhura nuk fshihen automatikisht.')){await remove('projects',p);await refresh();}if(w&&confirm('Të fshihet dritarja?')){await remove('windows',w);await refresh();}if(m&&confirm('Të fshihet materiali?')){await remove('materials',m);await refresh();}if(edit){const item=state.materials.find(x=>x.id===edit);openMaterialForm(item);}});
$$('.preview-tab').forEach(b=>b.addEventListener('click',()=>{$$('.preview-tab').forEach(x=>x.classList.toggle('active',x===b));state.preview=b.dataset.preview;const svg=$('#drawing svg');svg.classList.toggle('preview-3d',state.preview==='3d');$('#drawing .drawing-caption').textContent=state.preview==='3d'?'Pamje konceptuale 3D – vizualizimi i detajuar do të ndërtohet në fazën e figuracionit.':'Skemë paraprake 2D – konfigurimi do të përditësohet sipas zgjedhjeve.';}));
$('#exportBtn').addEventListener('click',async()=>{const data={app:'GZ Aluminium Glass & PVC',version:1,exportedAt:new Date().toISOString(),projects:await all('projects'),windows:await all('windows'),materials:await all('materials'),quotes:await all('quotes')};const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='GZ-backup-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href);toast('Backup u shkarkua.');});
$('#importBtn').addEventListener('click',async()=>{const file=$('#importFile').files[0];if(!file)return toast('Zgjidh fillimisht skedarin e backup-it.');if(!confirm('Importi do të zëvendësojë të dhënat aktuale. Vazhdo?'))return;try{const data=JSON.parse(await file.text());for(const n of ['projects','windows','materials','quotes']){if(!Array.isArray(data[n]))throw Error('Backup i pavlefshëm');const tx=db.transaction(n,'readwrite');tx.objectStore(n).clear();data[n].forEach(x=>tx.objectStore(n).put(x));await new Promise((r,j)=>{tx.oncomplete=r;tx.onerror=()=>j(tx.error);});}await refresh();toast('Backup u importua.');}catch(err){toast('Skedari nuk është backup i vlefshëm GZ.');}});
if('serviceWorker'in navigator)navigator.serviceWorker.register('./sw.js').catch(()=>{});
}
init().catch(err=>{console.error(err);toast('Gabim gjatë hapjes së databazës.');});
